# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key. SERVER ONLY. Never expose to the browser / commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin panel ---
# Single shared secret to open /admin and the admin API. Long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CURRENCY=USD

# WhatsApp number (digits only, incl. country code) shown to customers so they
# can send payment / the reference. Also used on the success screen.
NEXT_PUBLIC_SUPPORT_WHATSAPP=15550001234
