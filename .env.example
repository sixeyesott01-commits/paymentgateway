# --- Supabase ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (a.k.a. service_role). SERVER ONLY. Never expose / commit it.
# New Supabase projects call this the "secret key" (sb_secret_...).
# Either variable name works; set ONE of them:
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # legacy name, also accepted
#
# NOTE: the "publishable" key is NOT used by this app (all DB access is
# server-side). You do not need to set it.

# --- Admin panel ---
# Single shared secret to open /admin and the admin API. Long random string.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CURRENCY=USD

# --- Address autocomplete ---
# Provider chain: Radar (primary) -> Mapbox -> Nominatim/OSM (keyless fallback).
# ZIP -> city/state autofill uses free keyless APIs (Zippopotam + postalpincode.in).
# Radar publishable key (prj_live_pk_* / prj_test_pk_*). Primary provider.
NEXT_PUBLIC_RADAR_KEY=prj_live_pk_xxx
# Mapbox publishable token (pk.*) used as fallback for address type-ahead.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# WhatsApp number (digits only, incl. country code) shown to customers so they
# can send payment / the reference. Also used on the success screen.
NEXT_PUBLIC_SUPPORT_WHATSAPP=15550001234
